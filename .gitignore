# --- Binsight runtime data (database, photos, backups) ---
/data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# --- Secrets and local environment ---
.env
.env.*
!.env.example

# --- Python (backend) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
/backend/build/
/backend/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node (frontend) ---
node_modules/
/frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/frontend/coverage/

# End-to-end test output
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/playwright/.cache/

# --- Editors and operating system ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# --- Logs and temporary files ---
*.log
*.tmp

# --- Local agent and tool state ---
.claude/settings.local.json
graphify-out/

# --- Playwright: the signed-in owner kept between test projects ---
/frontend/playwright/.auth/
