{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh)",
      "Bash(./scripts/check.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Read(./data/**)",
      "Edit(./data/**)",
      "Edit(./frontend/src/types/api.generated.ts)",
      "Edit(./LICENSE)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/format-edited.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-before-stop.sh",
            "timeout": 300,
            "statusMessage": "Running scripts/check.sh"
          }
        ]
      }
    ]
  }
}
