{
  "format-edited": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [{ "type": "command", "command": "scripts/hooks/format-edited.sh", "timeout": 30 }]
      }
    ]
  },
  "guard-tool-use": {
    "PreToolUse": [
      {
        "matcher": "view_file|list_dir|find_by_name|grep_search|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [{ "type": "command", "command": "scripts/hooks/guard-tool-use.sh", "timeout": 10 }]
      }
    ]
  },
  "check-before-stop": {
    "Stop": [{ "type": "command", "command": "scripts/hooks/antigravity-check-before-stop.sh", "timeout": 300 }]
  }
}
